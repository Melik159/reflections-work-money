{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["id","statement","source","type","epistemic_status","concepts","depends_on","supports","contradicts","testability","root_question_relevance","interpretation_notes","confidence_in_reconstruction","interpretive","criticality"],
  "properties":{
    "id":{"type":"string","pattern":"^CPC-[0-9]{4}$"},
    "statement":{"type":"string","minLength":1},
    "source":{"type":"object","required":["document","page","pages","quotation"],"properties":{
      "document":{"const":"Reflections_PierreCampergue.pdf"},
      "page":{"type":"integer","minimum":1,"maximum":562},
      "pages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":562}},
      "quotation":{"type":"string","minLength":1}
    }},
    "type":{"enum":["DEFINITION","AXIOM","ASSUMPTION","CONCEPTUAL","DERIVED","MECHANISM","EMPIRICAL","PREDICTION","METHODOLOGICAL","ANALOGICAL","HYPOTHESIS","NORMATIVE","OPEN_QUESTION"]},
    "epistemic_status":{"enum":["SOURCE","INTERPRETATION","EMPIRICAL_RESULT","HYPOTHESIS","SPECULATION"]},
    "interpretive":{"type":"boolean"},
    "criticality":{"enum":["CORE","MAJOR","SUPPORTING","PERIPHERAL"]},
    "concepts":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "depends_on":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^CPC-[0-9]{4}$"}},
    "supports":{"type":"array"},"contradicts":{"type":"array"},
    "confidence_in_reconstruction":{"type":"number","minimum":0,"maximum":1},
    "testability":{"type":"string"},"root_question_relevance":{"type":"string","minLength":1},
    "interpretation_notes":{"type":"string","minLength":1}
  }
}
